# Voshod Web — переменные окружения
# Скопируй в .env.local для локальной разработки
# На сервере задай в PM2 или systemd
#
# ВАЖНО: реальные секреты (токены, ключи, client secret, shop id и т.д.)
# должны храниться только в `.env.local` / secret storage (CI/CD, Vault, etc.)
# и НЕ должны попадать в git.

# Источник каталога: directus | mock
CATALOG_SOURCE=directus

# Directus API
DIRECTUS_URL=https://admin.voshod.shop
DIRECTUS_TOKEN=replace_me   # Токен роли с правами Read + Create (orders, order_items)

# Имена коллекций (по умолчанию)
# DIRECTUS_COLLECTIONS_NAME=collections
# DIRECTUS_PRODUCTS_NAME=products
# DIRECTUS_ORDERS_NAME=orders
# DIRECTUS_ORDER_ITEMS_NAME=order_items

# ЮКасса (платежи)
# Тестовые ключи (test_), боевые — live_
YOOKASSA_SHOP_ID=replace_me
YOOKASSA_SECRET_KEY=replace_me
# Webhook URL в ЛК ЮKassa: https://<домен>/api/yookassa/webhook (также работает /api/payments/webhook)

# СДЭК API v2 (доставка)
# Тестовые ключи (автоматически определяют api.edu.cdek.ru)
# Боевые ключи получить: ЛК СДЭК → Интеграция → Создать ключ
CDEK_CLIENT_ID=replace_me
CDEK_CLIENT_SECRET=replace_me
CDEK_FROM_CITY_CODE=44      # Код города отправления (44 = Москва)
# CDEK_ENV=production        # production | test (по умолчанию production)
# CDEK_API_URL=             # Переопределить базовый URL (необязательно)
# CDEK_SENDER_NAME=         # Имя отправителя в заказе СДЭК (по умолчанию Voshod Shop)
# CDEK_SHIPMENT_POINT=      # Код ПВЗ/склада СДЭК отправителя (если договор требует shipment_point)

# Яндекс.Карты (для виджета СДЭК)
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=   # API-ключ Яндекс.Карт (JavaScript API и HTTP Геокодер)

# URL сайта (для return_url и webhook)
NEXT_PUBLIC_SITE_URL=https://voshod.shop

# Webhook security
# TRUST_PROXY=true  — включать только если запросы идут через ваш reverse proxy (nginx/caddy/cloud LB),
# который ПОЛНОСТЬЮ перезаписывает X-Forwarded-For / X-Real-IP и отбрасывает клиентские значения.
# Иначе злоумышленник сможет подставить IP из allowlist YooKassa.
TRUST_PROXY=replace_me
