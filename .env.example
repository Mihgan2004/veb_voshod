# Voshod Web — переменные окружения
# Скопируй в .env.local для локальной разработки
# На сервере задай в PM2 или systemd
#
# ВАЖНО: реальные секреты (токены, ключи, client secret, shop id и т.д.)
# должны храниться только в `.env.local` / secret storage (CI/CD, Vault, etc.)
# и НЕ должны попадать в git.

# Medusa Store API
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://api.projectrassvet.ru
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_replace_me
NEXT_PUBLIC_MEDUSA_REGION_ID=reg_replace_me

# URL сайта (для return_url, success page)
NEXT_PUBLIC_SITE_URL=https://projectrassvet.ru

# Manual payment provider ID in Medusa (optional override)
# MEDUSA_MANUAL_PAYMENT_PROVIDER=pp_system_default

# LEGACY — удалить после миграции
# CATALOG_SOURCE=directus
# DIRECTUS_URL=https://admin.voshod.shop
# DIRECTUS_TOKEN=replace_me
# DIRECTUS_DATABASE_URL=postgresql://directus:password@127.0.0.1:5432/directus
# DIRECTUS_PRODUCTS_SIZES_TABLE=products_sizes
# DIRECTUS_COLLECTIONS_NAME=collections
# DIRECTUS_PRODUCTS_NAME=products
# DIRECTUS_ORDERS_NAME=orders
# DIRECTUS_ORDER_ITEMS_NAME=order_items
# DIRECTUS_PRODUCTS_SIZES_NAME=products_sizes

# ЮКасса (платежи) — интеграция будет перенесена позже
YOOKASSA_SHOP_ID=replace_me
YOOKASSA_SECRET_KEY=replace_me
# Webhook URL в ЛК ЮKassa: https://<домен>/api/yookassa/webhook (legacy: /api/payments/webhook)
# YOOKASSA_RETURN_URL=https://projectrassvet.ru/checkout/success
# YOOKASSA_WEBHOOK_IP_ALLOWLIST_ENABLED=true
# YOOKASSA_RECEIPT_ENABLED=false
# YOOKASSA_RECEIPT_VAT_CODE=1
# YOOKASSA_RECEIPT_PAYMENT_SUBJECT=commodity
# YOOKASSA_RECEIPT_PAYMENT_MODE=full_payment
# YOOKASSA_RECEIPT_DELIVERY_SUBJECT=service

# СДЭК API v2 (доставка) — интеграция будет перенесена позже
CDEK_CLIENT_ID=replace_me
CDEK_CLIENT_SECRET=replace_me
CDEK_FROM_CITY_CODE=44
# CDEK_API_URL=
# CDEK_SENDER_NAME=
# CDEK_SHIPMENT_POINT=
# CDEK_TARIFF_CODE=

# Яндекс.Карты (для виджета СДЭК)
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=

# Webhook security (ЮKassa IP allowlist uses X-Forwarded-For only when true)
TRUST_PROXY=false
